# --- Core ---
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string

# --- Postgres ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO (S3) ---
S3_ENDPOINT_URL=http://minio:9000
# Browser-facing endpoint for presigned upload URLs (must match what the client uses).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-uploads
S3_REGION=us-east-1

# --- LLM provider ---
# openai | ollama | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct

# Used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Embeddings ---
# local | openai
EMBED_PROVIDER=local
EMBED_MODEL_LOCAL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# --- CORS / Origins ---
# Comma-separated origins for the portal API (the chat server uses per-site allowlists)
API_CORS_ORIGINS=http://portal.localhost,http://localhost:5173

# --- Auth ---
SESSION_COOKIE_NAME=rag_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=2592000

# --- Crawler ---
CRAWL_MAX_PAGES=200
CRAWL_MAX_DEPTH=3
CRAWL_USER_AGENT=RAGSiteAssistantBot/1.0
CRAWL_TIMEOUT_SECONDS=20

# --- Chat limits ---
CHAT_MAX_CONTEXT_CHUNKS=6
CHAT_HISTORY_TURNS=6
CHAT_RATE_LIMIT_PER_MIN=30
